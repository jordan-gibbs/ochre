{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ochre",
  "mainBinaryName": "ochre",
  "version": "0.1.0",
  "identifier": "io.github.jordangibbs.ochre",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Hold a key, talk, and polished text lands where you type.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "libasound2t64 | libasound2"],
        "recommends": ["xdotool", "xclip", "wl-clipboard", "ydotool", "ydotoold"],
        "desktopTemplate": "linux/ochre.desktop",
        "files": {
          "/usr/lib/udev/rules.d/60-ochre-uinput.rules": "linux/60-ochre-uinput.rules",
          "/usr/lib/modules-load.d/ochre-uinput.conf": "linux/ochre-uinput.conf"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3", "alsa-lib"],
        "recommends": ["xdotool", "xclip", "wl-clipboard", "ydotool"],
        "desktopTemplate": "linux/ochre.desktop",
        "files": {
          "/usr/lib/udev/rules.d/60-ochre-uinput.rules": "linux/60-ochre-uinput.rules",
          "/usr/lib/modules-load.d/ochre-uinput.conf": "linux/ochre-uinput.conf"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
